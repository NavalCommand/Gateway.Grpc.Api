{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "$env{NC_CLANG}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "VCPKG_INSTALLED_DIR": "$env{NC_VCPKG_INSTALLED_DIR}",
        "CMAKE_CXX_FLAGS": "--target=x86_64-pc-windows-msvc",
        "CMAKE_LINKER": "$env{NC_LINK}",
        "CMAKE_LINKER_TYPE": "MSVC"
      }
    },
    {
      "name": "windows-x64-sourcebuilt",
      "inherits": "windows-x64-release",
      "cacheVariables": {
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "jobs": 8
    },
    {
      "name": "windows-x64-sourcebuilt",
      "configurePreset": "windows-x64-sourcebuilt",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-sourcebuilt",
      "configurePreset": "windows-x64-sourcebuilt",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
