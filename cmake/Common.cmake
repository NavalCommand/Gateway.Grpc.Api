set(CMAKE_CXX_STANDARD 26)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
 set(CMAKE_CXX26_STANDARD_COMPILE_OPTION "/clang:-std=c++2c")
 set(CMAKE_CXX26_EXTENSION_COMPILE_OPTION "/clang:-std=c++2c")
 set(CMAKE_REQUIRED_FLAGS "/clang:-std=c++2c")
endif()
add_compile_options(/EHsc /utf-8)
include(CheckCXXSourceCompiles)
check_cxx_source_compiles("#include <expected>\nstatic_assert(__cplusplus >= 202400L); int main(){std::expected<int,int> x=1;return *x-1;}" NC_HAS_EXPECTED)
if(NOT NC_HAS_EXPECTED)
 message(FATAL_ERROR "C++26/latest mode with std::expected is required")
endif()
find_package(Protobuf CONFIG REQUIRED)
find_package(gRPC CONFIG REQUIRED)
find_package(GTest CONFIG REQUIRED)
find_package(spdlog CONFIG REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/CPM.cmake")
function(nc_dependency name)
 if(TARGET ${name})
  return()
 endif()
 string(REPLACE "." "_" key "${name}")
 set(url "${NC_${key}_URL}")
 if(DEFINED ENV{NC_REPOSITORY_BASE})
  set(url "$ENV{NC_REPOSITORY_BASE}/${name}")
 endif()
 if(NOT url OR NOT NC_${key}_REV)
  message(FATAL_ERROR "Missing pinned dependency ${name}")
 endif()
 CPMAddPackage(NAME ${key} GIT_REPOSITORY "${url}" GIT_TAG "${NC_${key}_REV}" OPTIONS "BUILD_TESTING OFF")
endfunction()



